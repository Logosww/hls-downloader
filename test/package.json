{
  "name": "@hls-downloader/test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run parse-hls.unit.test.ts retry.unit.test.ts web-download-manager.unit.test.ts capabilities.unit.test.ts renditions.unit.test.ts timeline-sidecars.unit.test.ts multitrack.unit.test.ts app-web-multitrack.unit.test.ts m5-realtime.unit.test.ts m5-gates.unit.test.ts",
    "test:integration": "vitest run hls-http.integration.test.ts writable-output.integration.test.ts browser-request.integration.test.ts timeline.integration.test.ts recording.integration.test.ts multitrack.integration.test.ts m5-rolling.integration.test.ts",
    "test:native:unit": "cargo test --manifest-path ../packages/adapters/src/node/crates/core/Cargo.toml --lib hls",
    "test:e2e": "vitest run library-api.e2e.test.ts",
    "test:e2e:publish": "pnpm run test:publish",
    "test:publish": "HLS_DOWNLOADER_TEST_PUBLISH_ENTRYPOINTS=1 vitest run library-api.e2e.test.ts publish-entrypoints.e2e.test.ts",
    "test:native": "vitest run node-adapter-transcode.test.ts",
    "test:native:contract": "vitest run node-adapter-contract.test.ts renditions.integration.test.ts",
    "test:watch": "vitest",
    "test:browser:writable": "node browser/writable-smoke.ts",
    "test:app-web:writable": "node browser/app-web-writable.ts",
    "test:native:resume": "cargo test --manifest-path ../packages/adapters/src/node/crates/core/Cargo.toml --test engine_upstream && vitest run node-resume.integration.test.ts",
    "test:browser:extension": "node browser/extension-smoke.ts",
    "test:app-web:metadata": "node browser/metadata-cancellation.ts",
    "test:browser:renditions": "node browser/renditions-smoke.ts",
    "test:app-web:renditions": "node browser/app-web-renditions.ts",
    "test:keyed": "vitest run keyed.integration.test.ts bounded.unit.test.ts",
    "test:browser:keyed": "node browser/keyed-smoke.ts",
    "test:timeline": "vitest run timeline.integration.test.ts timeline-sidecars.unit.test.ts",
    "test:browser:timeline": "pnpm run test:timeline && node browser/timeline-smoke.ts",
    "test:app-web:timeline": "node browser/app-web-timeline.ts",
    "test:recording": "vitest run recording.integration.test.ts",
    "test:browser:recording": "pnpm run test:recording && node browser/recording-smoke.ts",
    "test:multitrack": "vitest run multitrack.unit.test.ts multitrack.integration.test.ts",
    "test:browser:multitrack": "pnpm run test:multitrack && node browser/multitrack-smoke.ts",
    "test:app-web:multitrack": "vitest run app-web-multitrack.unit.test.ts web-download-manager.unit.test.ts && node browser/app-web-multitrack.ts",
    "test:engine": "vitest run engine.integration.test.ts node-resume.integration.test.ts",
    "test:browser:engine": "node browser/engine-smoke.ts",
    "test:m4": "vitest run m4-recovery.integration.test.ts m4-output.integration.test.ts packed-boundaries.integration.test.ts transcode-selected.integration.test.ts transcode-process.integration.test.ts",
    "test:browser:transcode": "node browser/transcode-smoke.ts",
    "test:players:fixtures": "HLS_PLAYER_FIXTURES=1 vitest run player-fixtures.integration.test.ts",
    "test:players:browser": "node players/browser.ts",
    "test:players:verify": "python3 players/verify.py",
    "test:subtitles": "vitest run subtitle-sidecars.integration.test.ts",
    "test:browser:subtitles": "node browser/subtitle-sidecars-smoke.ts",
    "test:m5:resources": "node m5/resources.ts",
    "test:m5:soak": "node m5/soak.ts",
    "test:m5:gates": "node m5/gates.ts"
  },
  "dependencies": {
    "@hls-downloader/core": "workspace:*",
    "@hls-downloader/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/m3u8-parser": "^7.2.6",
    "m3u8-parser": "^7.2.0",
    "playwright": "1.64.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
