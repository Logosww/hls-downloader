{
  "name": "@logosw/hls-downloader",
  "version": "3.7.0",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/Logosww/hls-downloader.git"
  },
  "workspaces": [
    "packages/*",
    "packages/app/*",
    "docs"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js"
    },
    "./adapters/browser": {
      "types": "./dist/adapters-browser.d.ts",
      "import": "./dist/adapters-browser.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters-node.d.ts",
      "import": "./dist/adapters-node.js"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:app-web": "turbo run dev --filter=@hls-downloader/app-web",
    "dev:app-bun": "turbo run dev --filter=@hls-downloader/app-bun",
    "build": "turbo run build --filter=!@hls-downloader/app-web --filter=!@hls-downloader/docs && tsdown -c tsdown.config.ts",
    "build:all": "turbo run build --filter=!@hls-downloader/docs && tsdown -c tsdown.config.ts",
    "build:root": "tsdown -c tsdown.config.ts",
    "prepublishOnly": "pnpm run build",
    "start:app-web": "turbo run start --filter=@hls-downloader/app-web",
    "test": "turbo run test --filter=@hls-downloader/test",
    "test:unit": "pnpm --filter @hls-downloader/test run test:unit",
    "test:integration": "pnpm --filter @hls-downloader/test run test:integration",
    "test:native:unit": "pnpm --filter @hls-downloader/test run test:native:unit",
    "test:e2e": "pnpm --filter @hls-downloader/test run test:e2e",
    "test:e2e:publish": "pnpm --filter @hls-downloader/test run test:e2e:publish",
    "test:publish": "pnpm --filter @hls-downloader/test run test:publish",
    "test:native": "pnpm --filter @hls-downloader/test run test:native",
    "test:native:contract": "pnpm --filter @hls-downloader/test run test:native:contract",
    "test:app-bun": "pnpm --filter @hls-downloader/app-bun run test:app-bun",
    "lint": "turbo run lint",
    "changelog": "node scripts/changelog.ts",
    "changelog:append": "node scripts/changelog.ts append",
    "changelog:sync": "node scripts/changelog.ts sync",
    "version:bump": "node scripts/bump-versions.ts",
    "adapters:setup-vcpkg-ffmpeg": "node scripts/setup-vcpkg-ffmpeg.ts",
    "adapters:inject-native-pkg-repository": "node scripts/inject-rust-native-pkg-repository.ts",
    "adapters:inject-optional-deps": "node scripts/inject-adapters-optional-deps.ts",
    "adapters:verify-native-install": "node scripts/verify-adapters-native-install.ts",
    "adapters:publish-native:current-platform": "node scripts/publish-rust-native-current-platform.ts",
    "docs:dev": "turbo run dev --filter=@hls-downloader/docs",
    "docs:build": "turbo run build --filter=@hls-downloader/docs",
    "docs:preview": "turbo run preview --filter=@hls-downloader/docs",
    "test:browser:writable": "pnpm --filter @hls-downloader/test run test:browser:writable",
    "test:app-web:writable": "pnpm --filter @hls-downloader/test run test:app-web:writable",
    "test:native:resume": "pnpm --filter @hls-downloader/test run test:native:resume",
    "test:types:resume": "tsc --ignoreConfig --noEmit --moduleResolution bundler --module esnext --target esnext --strict --skipLibCheck --typeRoots packages/adapters/node_modules/@types --types node test/resume-api.typecheck.ts",
    "test:browser:extension": "pnpm --filter @hls-downloader/test run test:browser:extension",
    "test:app-web:metadata": "pnpm --filter @hls-downloader/test run test:app-web:metadata",
    "test:native:prepared": "pnpm --filter @hls-downloader/test run test:native:prepared",
    "test:browser:renditions": "pnpm --filter @hls-downloader/test run test:browser:renditions",
    "test:types:renditions": "tsc --ignoreConfig --noEmit --moduleResolution bundler --module esnext --target esnext --strict --skipLibCheck --typeRoots packages/adapters/node_modules/@types --types node test/renditions-api.typecheck.ts",
    "test:app-web:renditions": "pnpm --filter @hls-downloader/test run test:app-web:renditions",
    "test:keyed": "pnpm --filter @hls-downloader/test run test:keyed",
    "test:browser:keyed": "pnpm --filter @hls-downloader/test run test:browser:keyed",
    "test:types:decryption": "tsc --ignoreConfig --noEmit --moduleResolution bundler --module esnext --target esnext --strict --skipLibCheck --typeRoots packages/adapters/node_modules/@types --types node test/decryption-api.typecheck.ts"
  },
  "dependencies": {
    "@hls-downloader/adapters": "workspace:*",
    "@hls-downloader/core": "workspace:*",
    "@hls-downloader/shared": "workspace:*",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.9.1"
}
